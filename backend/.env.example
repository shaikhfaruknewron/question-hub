# Copy to .env and fill in real values.

# Local MongoDB, or an Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=question-hub

# Only needed if your machine cannot resolve DNS SRV records, which breaks
# mongodb+srv:// with "querySrv ECONNREFUSED". Run `npm run doctor` to check.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Comma separated list of allowed frontend origins.
CLIENT_URL=http://localhost:3000

PORT=5000
NODE_ENV=development
